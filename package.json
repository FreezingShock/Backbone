{
  "name": "backbone",
  "private": true,
  "version": "0.1.0",
  "description": "Open-data, non-commercial 3D map of Topanga and the Santa Monica Mountains.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-cesium.mjs && vite",
    "dev:sync": "node scripts/dev-sync.mjs",
    "build": "node scripts/copy-cesium.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "postinstall": "node scripts/copy-cesium.mjs",
    "routing:build": "npx -y tsx scripts/build-routing-graph.ts",
    "routing:elevation": "npx -y tsx scripts/fetch-elevation.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "cesium": "1.146.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "shapefile": "^0.6.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
