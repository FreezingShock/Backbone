# Copy to .env.local and fill in. Never commit real values.

# Cesium ion access token (Community tier, free for personal and non-commercial use).
# Unlocks Cesium World Terrain. Without it the globe is flat ellipsoid.
# Create one at https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=

# Optional: override the default imagery service (any ArcGIS MapServer tile endpoint).
# Default is the USGS imagery service. Leave blank to use the default.
VITE_IMAGERY_URL=
